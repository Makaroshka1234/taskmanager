generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum MemberRole {
  OWNER
  ADMIN
  MEMBER  
}
enum Priority {
  LOW
  MEDIUM
  HIGH
}
enum BoardType {
  COLOR
  IMAGE
}
model User{
  id String @id @default(uuid())
  email String @unique
  password String
  boards Board[] 
  comments TaskComment[]

memberships BoardMember[]
@@unique([id, email])
created_at DateTime @default(now())
updated_at DateTime @updatedAt 
}
model Board{
id String @id @default(uuid())
title String
creator User @relation(fields: [creatorId], references: [id])
creatorId String
members BoardMember[]
boardLists BoardList[]
created_at DateTime @default(now())
backgroundType String @default("COLOR")
uploadedImages     String[]  @default([])
backgroundImageUrl String?
boardColor String?
  
} 

model BoardMember{
  id String @id @default(uuid())
  userId String
  boardId String
  role MemberRole
 user User @relation(fields: [userId],references: [id])
 board Board @relation(fields: [boardId],references: [id])
 


created_at DateTime @default(now())

}

model BoardList{
id String @id @default(uuid())
title String
tasks Task[]
boardId String
created_at DateTime @default(now())
board Board @relation(fields: [boardId],references: [id])

}
model Task{
 id String @id @default(uuid())
 title String
 priority Priority
 completed Boolean
 boardListId String
 comments TaskComment[]
 boardList BoardList @relation(fields: [boardListId],references: [id])

 created_at DateTime @default(now())

}
model TaskComment{
id String @id @default(uuid())
text String
creatorId String
taskId String
creatorEmail String

creator User @relation(fields: [creatorId,creatorEmail], references: [id,email])
task Task @relation(fields: [taskId],references: [id])
created_at DateTime @default(now())
updated_at DateTime @updatedAt 

}